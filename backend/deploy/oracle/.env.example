# TurnoControl backend: TEMPLATE ONLY. Copy to `.env` ON THE SERVER, fill it with scripts/generate-secrets.sh and edit the
# non-secret values by hand. `.env` is git-ignored, must be chmod 600 and owned by the deploying user.
# Never paste real values into this file, an issue, a chat or a log. Nothing here is ever shipped in the Android app
# except TURNO_ANON_KEY (public by design: it only identifies the API and maps to the `anon` role, which has no access).

# ---------------------------------------------------------------- PostgreSQL (generated, hex, never reused)
# supabase_admin / postgres. Used only from inside the server (migrations, backups).
TURNO_POSTGRES_PASSWORD=<generado-por-generate-secrets>
# PostgREST login role (can only switch to anon/authenticated after db/hardening).
TURNO_AUTHENTICATOR_PASSWORD=<generado-por-generate-secrets>
# GoTrue login role.
TURNO_AUTH_ADMIN_PASSWORD=<generado-por-generate-secrets>

# ---------------------------------------------------------------- JWT (generated)
# HS256 signing secret shared by GoTrue and PostgREST. 64 hex chars. Server-only; rotating it signs everybody out.
TURNO_JWT_SECRET=<generado-por-generate-secrets>
# Long-lived HS256 JWT with role=anon signed with TURNO_JWT_SECRET. The ONLY key the app may embed.
TURNO_ANON_KEY=<generado-por-generate-secrets>
# Access-token lifetime in seconds.
TURNO_JWT_EXPIRY=3600
# There is deliberately NO service_role key here. Admin operations mint a short-lived one on demand (SECURITY.md).

# ---------------------------------------------------------------- Public URLs (owner decision; no value invented)
# Public HTTPS base URL clients use, as served by the approved reverse proxy, e.g. https://<subdominio-aprobado>[:<puerto>]
TURNO_API_EXTERNAL_URL=https://<pendiente-de-aprobacion>
# Where GoTrue sends the browser after e-mail confirmation when no allowed redirect is given.
TURNO_SITE_URL=https://<pendiente-de-aprobacion>
# Exact, comma-separated redirect targets allowed after confirmation/recovery. Empty until the owner approves them.
TURNO_REDIRECT_ALLOW_LIST=

# ---------------------------------------------------------------- Sign-up policy
# true = nobody can create accounts (safe default until e-mail delivery and the privacy review are done).
TURNO_DISABLE_SIGNUP=true
# true ONLY in a throwaway staging stack with synthetic accounts. Never with real users.
TURNO_MAILER_AUTOCONFIRM=false
TURNO_PASSWORD_MIN_LENGTH=10

# ---------------------------------------------------------------- SMTP (provider not chosen yet)
TURNO_SMTP_ADMIN_EMAIL=
TURNO_SMTP_HOST=
TURNO_SMTP_PORT=587
TURNO_SMTP_USER=
TURNO_SMTP_PASS=
TURNO_SMTP_SENDER_NAME=TurnoControl

# ---------------------------------------------------------------- Google (prepared, disabled in compose.yaml)
# Comma-separated OAuth client IDs (web client first, then Android) from the owner's Google Cloud project.
TURNO_GOOGLE_CLIENT_IDS=
TURNO_GOOGLE_SECRET=

# ---------------------------------------------------------------- Gateway
# Loopback port on the server for the internal gateway. Check it is free first (scripts/preflight.sh).
TURNO_GATEWAY_PORT=18080

# Optional, for scripts/healthcheck.sh once public HTTPS exists: <host>:<port> of the public endpoint.
TURNO_PUBLIC_TLS_HOST=
