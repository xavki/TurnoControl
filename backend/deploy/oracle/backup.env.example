# TurnoControl backups: TEMPLATE ONLY. Copy to `backup.env` on the server (git-ignored, chmod 600).
# Contains NO database password: the scripts reach the database through `docker exec` inside the TurnoControl container.

# Absolute directory for local encrypted copies. Must contain "turnocontrol" in its path (safety check).
TURNO_BACKUP_DIR=/var/backups/turnocontrol
# age PUBLIC key (age1...). The matching private key is kept OFF the server (password manager / offline media).
TURNO_BACKUP_AGE_RECIPIENT=
# Days of local copies to keep (only files named turnocontrol-db-*.dump.age are ever deleted).
TURNO_BACKUP_LOCAL_RETENTION_DAYS=7
# Off-server destination for rclone, e.g. <remote>:<bucket>/turnocontrol. Retention there is enforced by the bucket's
# lifecycle rules, never by this script. Empty = the backup FAILS unless TURNO_BACKUP_ALLOW_LOCAL_ONLY=1.
TURNO_BACKUP_RCLONE_DEST=
TURNO_BACKUP_ALLOW_LOCAL_ONLY=0
# Alert if the newest local copy is older than this many hours (scripts/healthcheck.sh).
TURNO_BACKUP_MAX_AGE_HOURS=26
