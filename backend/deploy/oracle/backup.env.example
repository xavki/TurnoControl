# TurnoControl backups: TEMPLATE ONLY. Copy to `backup.env` on the server (git-ignored, chmod 600).
# Contains NO database password: the scripts reach the database through `docker exec` inside the TurnoControl container.

# Absolute directory for local encrypted copies. Must contain "turnocontrol" in its path (safety check).
TURNO_BACKUP_DIR=/var/backups/turnocontrol
# age PUBLIC key (age1...). The matching private key is kept OFF the server (password manager / offline media).
TURNO_BACKUP_AGE_RECIPIENT=
# Days of local copies to keep (only files named turnocontrol-db-*.dump.age are ever deleted).
TURNO_BACKUP_LOCAL_RETENTION_DAYS=7
# Off-server destination (scripts/lib-backup-dest.sh). Destination not chosen yet: owner decision.
#   none   no off-server copy (the backup FAILS unless TURNO_BACKUP_ALLOW_LOCAL_ONLY=1)
#   dir    a mounted directory (NAS, external disk)
#   rclone an rclone remote, e.g. <remote>:<bucket>/turnocontrol (S3-compatible / Oracle Object Storage)
TURNO_BACKUP_DEST_TYPE=none
TURNO_BACKUP_DEST=
# Must equal the content of the marker file `.turnocontrol-backup-destination` that the owner creates ONCE at the root of
# the destination. A destination without that exact marker is refused (wrong-destination protection).
TURNO_BACKUP_DEST_ID=
TURNO_BACKUP_ALLOW_LOCAL_ONLY=0
# rclone credentials live in rclone's own config file on the server (chmod 600), never here. Production: a WRITE-ONLY
# key on the bucket, retention enforced by the bucket's lifecycle rules (the scripts never delete in a bucket).
# Alert if the newest local copy is older than this many hours (scripts/healthcheck.sh).
TURNO_BACKUP_MAX_AGE_HOURS=26
